[include]
    path = ~/.gitconfig.local

[core]
    editor = vim
    excludesFile = ~/.gitignore.local

[init]
    defaultBranch = main

[push]
    default = upstream
    autoSetupRemote = true

[url "git@github.com:"]
    insteadOf = https://github.com/

[user]
    name = Jack Lewin
    email = 14926880+jack-lewin@users.noreply.github.com
    username = jack-lewin
